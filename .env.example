NEXT_PUBLIC_SITE_URL=https://northlinebuild.com

# Supabase Auth SSR (publishable values; safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_public_key
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_stable_32_byte_base64_key

# Supabase PostgreSQL persistence (server-only)
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_only_key
INQUIRY_HASH_SECRET=replace_with_at_least_32_random_bytes

# Transactional inquiry delivery (Resend)
INQUIRY_DELIVERY_MODE=database-only
# Set the mode to "email" and provide real values below to enable delivery.
RESEND_API_KEY=re_replace_with_server_only_key
INQUIRY_FROM_EMAIL=Northline Website <website@northlinebuild.com>
INQUIRY_TO_EMAIL=hello@northlinebuild.com
